{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre principale et fenêtres d'écriture : liens ouverts dans le navigateur du système, liens boitemail:// pour relier un compte, ouverture et fermeture d'une fenêtre pour écrire.",
  "windows": [
    "main",
    "ecrire-*"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "tel:*"
        }
      ]
    }
  ]
}
