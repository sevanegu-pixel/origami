{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre principale : liens ouverts dans le navigateur du système, liens boitemail:// pour relier un compte.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    { "identifier": "opener:allow-open-url", "allow": [ { "url": "https://*" }, { "url": "http://*" }, { "url": "mailto:*" }, { "url": "tel:*" } ] }
  ]
}
