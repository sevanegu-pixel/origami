{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boîte mail",
  "version": "0.1.0",
  "identifier": "ch.origami.boitemail",
  "build": { "frontendDist": "../www" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "Boîte mail", "width": 1400, "height": 900, "minWidth": 380, "minHeight": 520, "dragDropEnabled": false }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["boitemail"] } }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Boîte mail · plusieurs comptes",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" }
  }
}
